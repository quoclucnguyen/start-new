# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram Mini App Exchange URL (optional - defaults to Supabase Edge Function)
# NEXT_PUBLIC_TMA_EXCHANGE_URL=https://your-project.supabase.co/functions/v1/tma-exchange

# Anthropic API key for the AI chat assistant (server-only — dùng ở app/api/ai/chat,
# không commit key thật vào repo)
ANTHROPIC_API_KEY=

# Z.ai GLM Coding Plan key (server-only) — dùng khi provider = zai; bỏ trống nếu chỉ dùng Anthropic
ZAI_API_KEY=
